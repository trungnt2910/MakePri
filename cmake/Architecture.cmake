execute_process(
    COMMAND
        "${CMAKE_CXX_COMPILER}"
        -dumpmachine
    OUTPUT_VARIABLE MAKEPRI_COMPILER_TARGET
    OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY
)

if(MAKEPRI_COMPILER_TARGET MATCHES "^x86_64")
    set(MAKEPRI_ARCH "x86_64")
elseif(MAKEPRI_COMPILER_TARGET MATCHES "^i[3-6]86")
    set(MAKEPRI_ARCH "i686")
elseif(MAKEPRI_COMPILER_TARGET MATCHES "^aarch64")
    set(MAKEPRI_ARCH "aarch64")
elseif(MAKEPRI_COMPILER_TARGET MATCHES "^arm")
    set(MAKEPRI_ARCH "armv7")
else()
    set(MAKEPRI_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
endif()

if(MAKEPRI_COMPILER_TARGET MATCHES "^([^-]+)-w64-")
    set(MAKEPRI_RUNTIME_TARGET "${CMAKE_MATCH_1}-w64-mingw32")
else()
    set(MAKEPRI_RUNTIME_TARGET "${MAKEPRI_COMPILER_TARGET}")
endif()
