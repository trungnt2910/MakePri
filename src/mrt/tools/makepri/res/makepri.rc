            VALUE "OriginalFilename", "Makepri.exe\0"
            VALUE "ProductName", "Microsoft\x00AE Windows\x00AE Operating System\0"
            VALUE "ProductVersion", "10.0.26100.7705\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

