    MAKEPRI_STRING_INDEXES_IX_WRITE_OMIT_INDEX_ATTRIBUTE "    +/-Indexes(ix)                 - Write/Omit index attribute for ResourceMapSubtree, NamedResource,\n                                     Qualifier, QualifierSet and Decision elements"
    MAKEPRI_STRING_URIS_URI_WRITE_OMIT_URI_ATTRIBUTE "    +/-Uris(uri)                   - Write/Omit uri attribute for NamedResource elements"
    MAKEPRI_STRING_QUALIFIERINFO_QI_WRITE_OMIT_GLOBAL_QUALIFIERINFO "    +/-QualifierInfo(qi)           - Write/Omit global QualifierInfo element"
    MAKEPRI_STRING_RESOURCEMAPS_RM_WRITE_OMIT_RESOURCEMAP_ELEMENT "    +/-ResourceMaps(rm)            - Write/Omit ResourceMap element"
    MAKEPRI_STRING_VERSIONINFO_VI_WRITE_OMIT_VERSIONINFO_ELEMENT "    +/-VersionInfo(vi)             - Write/Omit VersionInfo element"
    MAKEPRI_STRING_EMPTYSUBTREES_ES_WRITE_OMIT_RESOURCEMAPSUBTREE_ELEMENTS "    +/-EmptySubtrees(es)           - Write/Omit ResourceMapSubtree elements for subtrees that do not\n                                     contain candidates"
    MAKEPRI_STRING_EMPTYNAMEDRESOURCES_ENR_WRITE_OMIT_NAMEDRESOURCE_ELEMENTS "    +/-EmptyNamedResources(enr)    - Write/Omit NamedResource elements for resources with no candidates"
    MAKEPRI_STRING_LINKS_L_WRITE_OMIT_LINK_ELEMENTS "    +/-Links(l)                    - Write/Omit Link elements"
    MAKEPRI_STRING_NAMEDRESEOURCEDECISION_NRD_WRITE_OMIT_DECISION_ELEMENT "    +/-NamedReseourceDecision(nrd) - Write/Omit Decision element in NamedResources"
    MAKEPRI_STRING_CANDIDATES_C_WRITE_OMIT_CANDIDATE_ELEMENT "    +/-Candidates(c)               - Write/Omit Candidate element for resources that do not use links"
    MAKEPRI_STRING_LINKEDCANDIDATES_LC_WRITE_OMIT_DEFAULT_CANDIDATE "    +/-LinkedCandidates(lc)        - Write/Omit(default) Candidate element for resources that do not use links"
