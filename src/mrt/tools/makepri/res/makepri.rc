LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 RT_MANIFEST "makepri.manifest"

1 VERSIONINFO
 FILEVERSION 10,0,26100,7705
 PRODUCTVERSION 10,0,26100,7705
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
